region = "us-east-1"
vpc_cidr = "10.30.0.0/16"
private_subnets = {
  "us-east-1a" = "10.30.1.0/24"
  "us-east-1b" = "10.30.2.0/24"
  "us-east-1c" = "10.30.3.0/24"
}
public_subnets = {
  "us-east-1a" = "10.30.101.0/24"
  "us-east-1b" = "10.30.102.0/24"
  "us-east-1c" = "10.30.103.0/24"
}
execution_role_arn = "arn:aws:iam::123456789012:role/movietowne-prod-ecs-execution"
task_role_arn      = "arn:aws:iam::123456789012:role/movietowne-prod-ecs-task"
database_url       = "postgresql+psycopg://app:password@prod-db.example.com:5432/movietowne"
redis_url          = "redis://prod-redis.example.com:6379/0"
common_env = {
  "TWILIO_ACCOUNT_SID" = "ACxxxxxxxx"
  "TWILIO_AUTH_TOKEN"  = "secure"
}
services = {
  ingestion = {
    cpu    = "1024"
    memory = "2048"
    image  = "123456789012.dkr.ecr.us-east-1.amazonaws.com/movietowne-ingestion:prod"
    port   = 8001
    env    = {}
  }
  scheduling = {
    cpu    = "2048"
    memory = "4096"
    image  = "123456789012.dkr.ecr.us-east-1.amazonaws.com/movietowne-scheduling:prod"
    port   = 8002
    env    = {}
  }
  messaging = {
    cpu    = "2048"
    memory = "4096"
    image  = "123456789012.dkr.ecr.us-east-1.amazonaws.com/movietowne-messaging:prod"
    port   = 8003
    env    = {}
  }
  admin = {
    cpu    = "1024"
    memory = "2048"
    image  = "123456789012.dkr.ecr.us-east-1.amazonaws.com/movietowne-admin:prod"
    port   = 8000
    env    = {}
  }
}
tags = {
  "project" = "movietowne"
  "env"     = "prod"
}
